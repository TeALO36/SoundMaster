# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.pyright/

# Virtual environments and local package metadata
.venv/
venv/
env/
*.egg-info/
.eggs/

# Build and release outputs
build/
dist/
build-*/
dist-*/
release/
*.spec.bak
build-*.log

# SoundMaster runtime data
.runtime/
logs/
*.db
*.db-shm
*.db-wal

# Downloaded models and local audio are never committed.
# Keep these outside the repository when possible with SOUNDMASTER_MODEL_DIR.
models/
.audio-cache/
audio-cache/
voice-samples/

# Local configuration, credentials, and generated legal profile
.env
.env.*
!.env.example
legal_profile.json
settings.local.json
*.local.json
*.secret
*.pem
*.p12
*.pfx

# AI coding tools (local config, caches and session data)
.claude/
.codebuff/
.freebuff/
.cursor/
.copilot/
.aider/
.continue/
.windsurf/
.gemini/
.codeium/
.roo/
.amazonq/

# IDE and editor files
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# Windows and macOS noise
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.log
